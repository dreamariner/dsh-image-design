{
  "name": "@dreamariner/dsh-image-design",
  "description": "图片设计：用图片模型生成图片，参数设置与结果查看对比（DSH 插件，能力对齐 mmx image generate）",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/generate-icon-art.mjs && node scripts/generate-mannequin-glb.mjs && tsdown && tsc -p tsconfig.types.json",
    "dev": "tsdown --watch",
    "prepare": "node scripts/generate-icon-art.mjs && node scripts/generate-mannequin-glb.mjs && tsdown && tsc -p tsconfig.types.json && node ../../scripts/sync-pack-docs.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-image-design"
  ],
  "license": "Apache-2.0",
  "author": "Jianan",
  "homepage": "https://github.com/dreamariner/dsh-image-design",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamariner/dsh-image-design",
    "directory": "packages/dsh-image-design"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.19.0 <4.0.0-0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "three": "^0.170.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.170.0",
    "js-yaml": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9",
    "vitest": "^5.0.3"
  }
}
